# Copy to .env.local and fill in. Never commit real values.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only (later phases) — never prefix with NEXT_PUBLIC_
SUPABASE_SECRET_KEY=              # Phase 2: writes to destination_cache (sb_secret_…)
APIFY_API_TOKEN=                  # Phase 2: Google Maps Scraper (APIFY_TOKEN also accepted)
# Optional Apify spend controls (defaults shown)
# APIFY_MAX_PLACES_PER_SEARCH=12  # × 3 searches ≈ $0.14 per new destination on the free tier
# APIFY_DAILY_RUN_LIMIT=15        # max fresh Apify runs per rolling 24 h
GEMINI_API_KEY=                   # Phase 3: server only
GEMINI_MODEL=gemini-3.5-flash     # falls back to gemini-3.8-flash, gemini-flash-latest when busy
